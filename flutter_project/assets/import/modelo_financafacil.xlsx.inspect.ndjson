{"kind":"table","sheet":"Como preencher","address":"A1:I17","rows":17,"cols":9,"values":[[null,null,null,null,null,null,null,null,null],["Importação de contas e rendas",null,null,null,null,null,null,null,null],[null,null,null,null,null,null,null,null,null],["Preencha somente a aba Lançamentos. Os exemplos abaixo não são importados.",null,null,null,null,null,null,null,null],["Uma linha por renda ou conta. Digite o valor de cada mês, não a soma das parcelas.",null,null,null,null,null,null,null,null],["Primeiro vencimento: data completa. Ela define o mês de início e o dia mensal.",null,null,null,null,null,null,null,null],["Recorrente = Sim: meses vazios significa que a conta não tem data final.",null,null,null,null,null,null,null,null],["Para parcelas, informe de 2 a 1200 meses restantes. Comece no próximo vencimento.",null,null,null,null,null,null,null,null],["Categoria: use uma categoria do app. Se não existir, escolha outra na prévia.",null,null,null,null,null,null,null,null],["Dia de vencimento: opcional, de 1 a 31. Em fevereiro o dia 31 vira o último dia do mês.",null,null,null,null,null,null,null,null],["Não use fórmulas. Todos os cadastros entram pendentes, para confirmação manual.",null,null,null,null,null,null,null,null],[null,null,null,null,null,null,null,null,null],["Descrição","Tipo","Valor mensal","Primeiro vencimento","Recorrente","Quantidade de meses","Categoria","Observações","Dia de vencimento"],["Salário","Receita",5000,"2026-11-05T00:00:00.000Z","Sim",null,"Salário","Exemplo de renda mensal",null],["Aluguel","Despesa",1500,"2026-11-10T00:00:00.000Z","Sim",null,"Moradia","Sem data final",null],["Ótica","Despesa",90.6,"2026-11-08T00:00:00.000Z","Sim",10,"Saúde","Transferir para meu pai",null],["Conserto do carro","Despesa",350,"2026-11-15T00:00:00.000Z","Não",null,"Transporte","Pagamento avulso",null]]}
